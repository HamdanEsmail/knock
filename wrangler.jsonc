{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "knock",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "knock",
      "database_id": "6de2631b-cc0d-4555-bef1-9c3cdb0532a6",
      "migrations_dir": "migrations"
    }
  ],
  "workflows": [
    {
      "name": "knock-list",
      "binding": "LIST_WORKFLOW",
      "class_name": "ListWorkflow"
    },
    {
      "name": "knock-set",
      "binding": "SET_WORKFLOW",
      "class_name": "SetWorkflow"
    }
  ],
  "vars": {
    "PUBLIC_BASE_URL": "https://knock.hamdanesmail12-7a9.workers.dev",
    // The most Knock may spend in total, in dollars. 0 means nothing paid ever happens.
    // Two dollars of it are kept for pages; the rest is what TinySet sets may cost.
    "SPEND_CAP_USD": "20"
  },
  "assets": {
    "directory": "./public"
  },
  "observability": {
    "enabled": true
  }
}
